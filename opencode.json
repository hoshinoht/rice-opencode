{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-antigravity-auth@1.6.0",
    "opencode-anthropic-auth@0.0.13",
    "@mohak34/opencode-notifier@0.2.4",
    "opencode-mem@2.13.0",
    "opencode-background-agents@0.1.1"
  ],
  "tools": {
    "hound_smart_search": false
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      },
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "researcher-mcp": {
      "type": "local",
      "command": ["sh", ".opencode/researcher-mcp.sh"],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "oauth": false,
      "headers": {
        "x-api-key": "{file:~/.config/opencode/.exa-api-key}"
      },
      "enabled": true
    },
    "hound": {
      "type": "local",
      "command": ["uvx", "--from", "hound-mcp[all]==12.4.1", "hound"],
      "enabled": true,
      "timeout": 120000
    },
    "ddg-search": {
      "type": "local",
      "command": ["npx", "-y", "@oevortex/ddg_search@latest"],
      "enabled": true
    }
  }
}
