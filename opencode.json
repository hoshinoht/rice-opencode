{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-anthropic-auth@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-mem",
    "opencode-background-agents@0.1.1",
    "/Users/cantabile/opencode-anthropic-auth",
    "/Users/cantabile/opencode-recall",
    "./src/plugins/qwen-single-system.ts"
  ],
  "agent": {
    "plan": {
      "description": "Strategic planning agent. Analyzes requirements, delegates research, and creates implementation plans.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "prompt": "{file:prompts/planner-prompt.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "edit": "deny",

        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow"
        },

        "task": {
          "*": "deny",
          "explore": "allow",
          "docs-first-coder": "allow",
          "code-checker": "allow",
          "document-proofreader": "allow"
        }
      }
    },
    "build": {
      "description": "Primary implementation agent. Executes approved plans, delegates specialist work, tests changes, and verifies results.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:prompts/builder-prompt.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "websearch": "allow",
        "webfetch": "allow",

        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git clean*": "ask",
          "rm -rf*": "ask"
        },

        "task": {
          "*": "deny",
          "explore": "allow",
          "docs-first-coder": "allow",
          "frontend-engineer": "allow",
          "code-checker": "allow",
          "document-writer": "allow",
          "document-proofreader": "allow"
        }
      }
    },

    "explore": {
      "description": "Fast read-only repository navigator. Locates files, symbols, configuration, logs, and relevant implementation details.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "prompt": "{file:agents/explore.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "websearch": "deny",
        "webfetch": "deny",

        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow"
        },

        "task": "deny"
      }
    },

    "docs-first-coder": {
      "description": "Documentation-first implementation specialist. Verifies external APIs against authoritative documentation before modifying code.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:agents/docs-first-coder.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "deny"
      }
    },

    "frontend-engineer": {
      "description": "Frontend specialist for production-grade UI architecture, accessibility, responsiveness, interaction, and visual implementation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:agents/frontend-engineer.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "deny"
      }
    },

    "code-checker": {
      "description": "Read-only verification specialist. Reviews correctness, maintainability, specification alignment, tests, edge cases, and regressions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:agents/code-checker.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "edit": "deny",

        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git status*": "allow",
          "git log*": "allow"
        },

        "websearch": "deny",
        "webfetch": "deny",
        "task": "deny"
      }
    },

    "document-writer": {
      "description": "Professional technical and academic document author using the configured document toolchain.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:agents/document-writer.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",

        "bash": {
          "*": "ask",
          "pandoc *": "allow",
          "latexmk *": "allow",
          "pdflatex *": "allow",
          "xelatex *": "allow"
        },

        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",

        "docs_*": "allow"
      }
    },

    "document-proofreader": {
      "description": "Read-only academic and technical reviewer. Checks writing, evidence, structure, reasoning, consistency, and unsupported claims.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "{file:agents/document-proofreader.md}",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",

        "bash": {
          "*": "deny",
          "git diff*": "allow"
        },

        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      },
      "enabled": false
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "researcher-mcp": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "$HOME/.config/opencode/mcps/researcher-mcp/bin/researcher-mcp"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "oauth": false,
      "headers": {
        "x-api-key": "{file:~/.config/opencode/.exa-api-key}"
      },
      "enabled": false
    },
    "gofetch": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "$HOME/.config/opencode/mcps/gofetch-mcp/bin/gofetch"
      ],
      "enabled": true
    },
    "ats-tailor": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "uv run --project $HOME/projects/personal/resume/ats-tailor ats-tailor mcp --repo $HOME/projects/personal/resume"
      ],
      "enabled": true
    }
  },
  "provider": {
    "vllm-hotaisle": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LocalLLM",
      "options": {
        "baseURL": "http://promaxgb10-f4db.tailab1c77.ts.net:8000/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive": {
          "name": "Qwen3.6 35B A3B HauhauCS Aggressive FP8",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}
